<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings used by the Jenkins "Deploy to Nexus" stage.
  No passwords are stored here: Jenkins injects NEXUS_USERNAME and NEXUS_PASSWORD
  from the 'nexus-credentials' credential at build time.
  The server ids match <distributionManagement> in pom.xml.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>nexus-releases</id>
      <username>${env.NEXUS_USERNAME}</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
    <server>
      <id>nexus-snapshots</id>
      <username>${env.NEXUS_USERNAME}</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
  </servers>
</settings>
